# Public, non-secret build config for the iOS/Android app (`npm run build:native`).
# Secrets never go here. VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY come
# from the environment (Doppler locally, GitHub Actions secrets in CI).
#
# The app shell is not same-origin with the API, so calls go to the deployed origin.
VITE_API_BASE_URL=https://ficium.vercel.app
# Origin of password-reset / share links; must match the universal/App Link domain.
VITE_PUBLIC_APP_URL=https://ficium.vercel.app
