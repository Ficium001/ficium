# =============================================================
# Ficium — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# =============================================================

# ── Client-side (prefixed VITE_) ──────────────────────────────
# These are bundled into the frontend. Use only publishable keys here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Canonical Ficium Portal URL — bank/admin users are redirected here.
# Optional; falls back to https://portal.ficium.net if unset.
VITE_PORTAL_URL=https://portal.ficium.net

# ficium-portal-api base URL — backs /portfolio (accepted facilities live in
# the Institution project, which this app's Supabase client cannot reach).
# Required for My Portfolio; the page shows an error if unset.
VITE_PORTAL_API_URL=https://ficium-portal-api-production.up.railway.app

# ── Server-side only (Vercel environment variables) ───────────
# These must NEVER be used in frontend code.
# Set these in Vercel dashboard → Settings → Environment Variables.

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=sk-ant-...
RESEND_API_KEY=re_...

# ── Optional ──────────────────────────────────────────────────
VITE_ADMIN_SECRET=your-admin-secret     # KYC admin reset endpoint
