<?xml version="1.0" encoding="utf-8"?>
<!-- TLS only, system CAs only: no cleartext, no user-installed CAs (blocks
     proxy-based interception on a compromised or managed device). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
